# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://retroman:CHANGE_ME@localhost:5432/retroman"

POSTGRES_DB=retroman
POSTGRES_USER=retroman
POSTGRES_PASSWORD=CHANGE_ME

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://your-domain.com"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"

# ─── Encryption (for API keys & MFA secrets stored in DB) ─────────────────────
# Must be exactly 64 hex characters (= 32 bytes) — generate with: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS_openssl_rand_-hex_32_____________________"

# ─── Local development only ───────────────────────────────────────────────────
# Skips the login and treats you as the first account. Convenient locally,
# catastrophic anywhere else — leave this unset on any reachable instance.
# Deliberately its own switch rather than being tied to NODE_ENV: a forgotten
# NODE_ENV must lock the app, not open it. A production build ignores it.
# DEV_SKIP_AUTH=true

# ─── Mail (password reset) ────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable the self-service password reset entirely:
# the "Passwort vergessen?" link disappears and both reset pages return 404.
# Mails are then written to the server log instead of being sent, which is the
# normal state in local development.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
# Set to "false" only for a server that cannot do STARTTLS on port 587.
SMTP_USE_TLS=true
# Must be a real address, not just a display name — servers reject the latter.
SMTP_FROM="RetroMan <no-reply@your-domain.com>"

# Used to build the link inside reset mails. Without it the link points at
# localhost and is useless in a mail someone receives.
APP_BASE_URL="http://your-domain.com"

# ─── Optional ─────────────────────────────────────────────────────────────────
HTTP_PORT=80
