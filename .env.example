# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Which version to run ─────────────────────────────────────────────────────
# The image tag docker-compose.yml pulls. Pin an actual release rather than
# leaving it to "latest": otherwise every restart may pull a different image,
# and after a bad release there is no version to roll back to.
RETROMAN_VERSION=1.2.3

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://retroman:CHANGE_ME@localhost:5432/retroman"

POSTGRES_DB=retroman
POSTGRES_USER=retroman
POSTGRES_PASSWORD=CHANGE_ME

# ─── Auth ─────────────────────────────────────────────────────────────────────
# The address the application is reached under from outside — behind a
# reverse proxy the public one, not the internal host and port. Used for
# links in mails; the session cookie is bound to the actual connection
# instead (lib/auth/cookieBinding.ts), so both ways in keep working.
NEXTAUTH_URL="https://retroman.your-domain.com"
# 32 random bytes as standard base64. openssl is NOT installed on a bare
# Docker host, so these use only what is always there:
#   Linux:      head -c 32 /dev/urandom | base64
#   PowerShell: $b=[byte[]]::new(32);[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b)
NEXTAUTH_SECRET="CHANGE_ME"

# ─── Encryption (for API keys & MFA secrets stored in DB) ─────────────────────
# Exactly 64 hex characters (= 32 bytes). Note this is a different format from
# the secret above — a base64 value will not work here, and vice versa.
#   Linux:      od -An -tx1 -N32 /dev/urandom | tr -d " \n"
#   PowerShell: $b=[byte[]]::new(32);[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);($b|ForEach-Object{$_.ToString("x2")}) -join ""
ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS_openssl_rand_-hex_32_____________________"

# ─── Local development only ───────────────────────────────────────────────────
# Skips the login and treats you as the first account. Convenient locally,
# catastrophic anywhere else — leave this unset on any reachable instance.
# Deliberately its own switch rather than being tied to NODE_ENV: a forgotten
# NODE_ENV must lock the app, not open it. A production build ignores it.
# DEV_SKIP_AUTH=true

# ─── Mail (password reset) ────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable the self-service password reset entirely:
# the "Passwort vergessen?" link disappears and both reset pages return 404.
# Mails are then written to the server log instead of being sent, which is the
# normal state in local development.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
# Set to "false" only for a server that cannot do STARTTLS on port 587.
SMTP_USE_TLS=true
# Must be a real address, not just a display name — servers reject the latter.
SMTP_FROM="RetroMan <no-reply@your-domain.com>"

# Used to build the link inside reset mails. Without it NEXTAUTH_URL is
# used, which is normally the same address — set this only where the two
# differ.
# APP_BASE_URL="https://retroman.your-domain.com"
